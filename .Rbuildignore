^LICENSE\.md$
^\.github$
^_pkgdown\.yml$
^docs$
^pkgdown$
^\.claude$
^\.agents$
^tools$
## R CMD build strips src/*.o but not object files in src subdirectories.
^src/.*\.o$
^src/.*\.so$
^src/.*\.dll$
^doc$
^Meta$
^cran-comments\.md$
## Articles under vignettes/articles/ are built by pkgdown only; they are
## not package vignettes and never run in R CMD check.
^vignettes/articles$
