;; Value mapping at the R/Wasm boundary, and one export of every kind.
(module
  (func (export "add") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func (export "id_i32") (param i32) (result i32) local.get 0)
  (func (export "id_i64") (param i64) (result i64) local.get 0)
  (func (export "id_f32") (param f32) (result f32) local.get 0)
  (func (export "id_f64") (param f64) (result f64) local.get 0)
  (func (export "swap") (param i32 i64) (result i64 i32)
    local.get 1 local.get 0)
  (func (export "nothing"))
  (func (export "i64_2p53") (result i64) i64.const 9007199254740992)
  (func (export "i64_2p53_plus_1") (result i64) i64.const 9007199254740993)
  (func (export "i64_min") (result i64) i64.const -9223372036854775808)
  (func (export "takes_funcref") (param funcref))
  (func (export "returns_externref") (result externref) ref.null extern)
  (memory (export "memory") 1 2)
  (global (export "counter") (mut i32) (i32.const 0))
  (global (export "answer") i64 (i64.const 42))
  (table (export "table") 2 funcref))
