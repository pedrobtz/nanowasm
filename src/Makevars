## toywasm is vendored in src/toywasm/ and built from source.
##
## -I.        toywasm includes "toywasm_config.h", which nanowasm writes by
##            hand in src/ in place of upstream's CMake-generated one.
## -Itoywasm  the vendored sources include each other by bare name.
## -DNDEBUG   besides assertions (which tools/vendor/patch-for-r.sh already
##            neutralises), NDEBUG turns off a debugging aid in exec.c that
##            injects an artificial restart every tenth interrupt check.
PKG_CPPFLAGS = -I. -Itoywasm -DNDEBUG

## TOYWASM_OBJECTS is an explicit list generated by tools/vendor-toywasm.sh.
## It is not built with $(wildcard), which R CMD check flags as a GNU make
## extension.
include toywasm/objects.mk

OBJECTS = init.o info.o toywasm_shim.o $(TOYWASM_OBJECTS)
